# Copy to .env (untracked) and replace every placeholder: cp .env.example .env
# Local-only SQL Server SA password for docker compose. Use a strong value (8+ chars, mixed case, digit, symbol).
SQLSERVER_SA_PASSWORD=replace-with-a-strong-local-development-password
# Your TrackTik mock OAuth2 client credentials. Never commit real values.
TRACKTIK_CLIENT_ID=replace-with-your-client-id
TRACKTIK_CLIENT_SECRET=replace-with-your-client-secret
