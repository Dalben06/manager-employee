# Local-only values for the Postman end-to-end stack (docker-compose.postman.yml).
# These are NOT real credentials: TrackTik is replaced by a local WireMock stub that
# accepts any client, and the SQL Server password only protects a throwaway container.
SQLSERVER_SA_PASSWORD=PostmanLocalOnly2026x
TRACKTIK_CLIENT_ID=postman-stub
TRACKTIK_CLIENT_SECRET=postman-stub
API_PORT=8081
SQLSERVER_PORT=14334
STUB_PORT=8089
