{
  "request": {
    "method": "POST",
    "urlPath": "/v1/employees",
    "headers": { "Authorization": { "matches": "Bearer .+" } }
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{{request.body}}",
    "transformers": ["response-template"]
  }
}
