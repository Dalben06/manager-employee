{
  "request": {
    "method": "PUT",
    "urlPathPattern": "/v1/employees/[^/]+",
    "headers": { "Authorization": { "matches": "Bearer .+" } }
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "body": "{{request.body}}",
    "transformers": ["response-template"]
  }
}
